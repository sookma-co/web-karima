{
  "name": "web-karima",
  "version": "1.0.0",
  "description": "Karima Courses responsive multi-language (EN, DE, ID) landing page built with Node.js 24, EJS, and Bootstrap 5.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs --watch",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev-server.mjs --preview",
    "test": "node --test tests/*.test.mjs",
    "security:audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "bootstrap": "^5.3.3",
    "ejs": "^3.1.10"
  },
  "devDependencies": {
    "sass": "^1.86.0"
  }
}
