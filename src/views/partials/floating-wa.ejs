<a
  class="kc-floating-wa"
  href="<%= waLinks.floating %>"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="<%= t.a11y.floatingWaLabel %>"
>
  <span class="kc-wa-online-dot" aria-hidden="true"></span>
  <img src="/assets/icons/icon-wa-white.png" alt="" width="20" height="20" class="kc-floating-wa-icon">
  <span class="kc-floating-wa-label"><%= t.floatingWa.label %></span>
</a>
