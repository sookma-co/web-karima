<header class="kc-navbar-wrap sticky-top">
  <nav class="navbar navbar-expand-xl kc-navbar" aria-label="Main navigation">
    <div class="container-xxl kc-container">
      <a class="navbar-brand kc-brand" href="#top" aria-label="<%= t.a11y.brandHome %>">
        <img
          src="/assets/images/logo-karima.png"
          alt=""
          width="54"
          height="54"
          class="kc-brand-logo"
        >
        <span class="kc-brand-wordmark">
          <span class="kc-brand-primary"><%= site.brand.primary %></span>
          <span class="kc-brand-secondary"><%= site.brand.secondary %></span>
        </span>
      </a>

      <!-- Mobile/Tablet controls: Language selector + Hamburger -->
      <div class="d-flex align-items-center gap-2 d-xl-none">
        <div class="dropdown">
          <button
            class="kc-lang-btn dropdown-toggle"
            type="button"
            id="langDropdownMobile"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="<%= t.a11y.languageSwitcher %>"
          >
            <img src="/assets/icons/icon-globe.png" alt="" width="20" height="20" class="kc-lang-globe">
            <span><%= localeMeta.label %></span>
            <img src="/assets/icons/icon-chevron-down.svg" alt="" width="8" height="5" class="kc-lang-chevron">
          </button>
          <ul class="dropdown-menu dropdown-menu-end kc-lang-menu" aria-labelledby="langDropdownMobile">
            <% site.locales.forEach((loc) => { %>
            <li>
              <a
                class="dropdown-item kc-lang-item <%= loc.code === localeMeta.code ? 'active' : '' %>"
                href="/<%= loc.code %>/"
                hreflang="<%= loc.code %>"
                data-lang-choice="<%= loc.code %>"
              >
                <span class="kc-lang-code"><%= loc.label %></span>
                <span><%= loc.name %></span>
              </a>
            </li>
            <% }); %>
          </ul>
        </div>

        <button
          class="kc-menu-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#karimaNavbarNav"
          aria-controls="karimaNavbarNav"
          aria-expanded="false"
          aria-label="<%= t.a11y.openMenu %>"
        >
          <img src="/assets/icons/icon-menu.svg" alt="" width="22" height="22">
        </button>
      </div>

      <div class="collapse navbar-collapse" id="karimaNavbarNav">
        <ul class="navbar-nav mx-xl-auto kc-nav-list">
          <li class="nav-item"><a class="nav-link kc-nav-link" href="#about"><%= t.nav.about %></a></li>
          <li class="nav-item"><a class="nav-link kc-nav-link" href="#courses"><%= t.nav.courses %></a></li>
          <li class="nav-item"><a class="nav-link kc-nav-link" href="#skills"><%= t.nav.skills %></a></li>
          <li class="nav-item"><a class="nav-link kc-nav-link" href="#pricing"><%= t.nav.pricing %></a></li>
          <li class="nav-item"><a class="nav-link kc-nav-link" href="#testimonials"><%= t.nav.testimonials %></a></li>
          <li class="nav-item"><a class="nav-link kc-nav-link" href="#faq"><%= t.nav.faq %></a></li>
        </ul>

        <div class="kc-nav-actions d-flex align-items-xl-center flex-column flex-xl-row gap-2">
          <!-- Desktop Language Dropdown -->
          <div class="dropdown d-none d-xl-block">
            <button
              class="kc-lang-btn dropdown-toggle"
              type="button"
              id="langDropdownDesktop"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              aria-label="<%= t.a11y.languageSwitcher %>"
            >
              <img src="/assets/icons/icon-globe.png" alt="" width="20" height="20" class="kc-lang-globe">
              <span><%= localeMeta.label %></span>
              <img src="/assets/icons/icon-chevron-down.svg" alt="" width="8" height="5" class="kc-lang-chevron">
            </button>
            <ul class="dropdown-menu dropdown-menu-end kc-lang-menu" aria-labelledby="langDropdownDesktop">
              <% site.locales.forEach((loc) => { %>
              <li>
                <a
                  class="dropdown-item kc-lang-item <%= loc.code === localeMeta.code ? 'active' : '' %>"
                  href="/<%= loc.code %>/"
                  hreflang="<%= loc.code %>"
                  data-lang-choice="<%= loc.code %>"
                >
                  <span class="kc-lang-code"><%= loc.label %></span>
                  <span><%= loc.name %></span>
                </a>
              </li>
              <% }); %>
            </ul>
          </div>

          <a
            class="kc-btn kc-btn-dark kc-btn-nav"
            href="<%= waLinks.general %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src="/assets/icons/icon-wa-white.png" alt="" width="22" height="22" class="kc-btn-icon">
            <span><%= t.nav.contactAdmin %></span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
