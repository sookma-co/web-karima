<section class="kc-section kc-about" id="about">
  <div class="container-xxl kc-container">
    <div class="kc-section-header text-center mx-auto">
      <div class="kc-eyebrow"><%= t.about.badge %></div>
      <h2 class="kc-section-title"><%= t.about.heading %></h2>
    </div>

    <!-- Founder / Lead Mentor Profile Card -->
    <div class="kc-mentor-card mt-5">
      <div class="row align-items-center gy-4 gx-lg-5">
        <div class="col-12 col-lg-7">
          <div class="kc-mentor-pill mb-3">
            <img src="/assets/icons/icon-productivity.svg" alt="" width="18" height="18">
            <span><%= t.about.mentorBadge %></span>
          </div>

          <h3 class="kc-mentor-name"><%= t.about.mentorName %></h3>
          <p class="kc-mentor-quote" lang="en"><%= t.about.mentorQuote %></p>

          <p class="kc-mentor-bio-primary"><%= t.about.bioParagraph1 %></p>
          <p class="kc-mentor-bio-secondary"><%= t.about.bioParagraph2 %></p>

          <div class="kc-open-space-box">
            <img src="/assets/icons/icon-rainbow.svg" alt="" width="24" height="24" class="kc-open-space-icon">
            <p class="mb-0">
              <%= t.about.openSpacePrefix %><strong><%= t.about.openSpaceHighlight %></strong><%= t.about.openSpaceSuffix %>
            </p>
          </div>
        </div>

        <div class="col-12 col-lg-5">
          <div class="kc-portrait-panel">
            <div class="kc-portrait-frame">
              <img
                src="/assets/images/ned-taufik.png"
                alt="<%= t.a11y.nedPortraitAlt %>"
                width="422"
                height="430"
                loading="lazy"
                class="kc-portrait-img"
              >
              <div class="kc-portrait-badge">
                <img src="/assets/icons/icon-verified.svg" alt="" width="20" height="20">
                <span><%= t.about.portraitBadge %></span>
              </div>
            </div>

            <div class="kc-mentor-stats-box">
              <div class="row g-0 text-center">
                <% t.about.mentorStats.forEach((stat, idx) => { %>
                <div class="col-4">
                  <div class="kc-mentor-stat-cell <%= idx < t.about.mentorStats.length - 1 ? 'kc-mentor-stat-border' : '' %>">
                    <div class="kc-mentor-stat-num"><%= stat.value %></div>
                    <div class="kc-mentor-stat-lbl"><%= stat.label %></div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>

            <div class="d-grid gap-2 mt-3">
              <a
                class="kc-profile-link-btn"
                href="<%= site.contact.superprofUrl %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                <img src="/assets/icons/icon-school-dark.svg" alt="" width="22" height="22">
                <span class="flex-grow-1 text-center"><%= t.about.superprofCta %></span>
                <img src="/assets/icons/icon-external-link.svg" alt="" width="14" height="14" class="kc-ext-icon">
              </a>
              <a
                class="kc-profile-link-btn"
                href="<%= site.contact.linkedinUrl %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                <img src="/assets/icons/icon-linkedin-dark.svg" alt="" width="20" height="20">
                <span class="flex-grow-1 text-center"><%= t.about.linkedinCta %></span>
                <img src="/assets/icons/icon-external-link.svg" alt="" width="14" height="14" class="kc-ext-icon">
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mission & Vision -->
    <div class="row g-4 mt-2">
      <div class="col-12 col-md-6">
        <article class="kc-info-card h-100">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="kc-icon-box">
              <img src="/assets/icons/icon-explore.svg" alt="" width="24" height="24">
            </div>
            <h4 class="kc-card-title mb-0"><%= t.about.missionTitle %></h4>
          </div>
          <p class="kc-card-text mb-0"><%= t.about.missionBody %></p>
        </article>
      </div>

      <div class="col-12 col-md-6">
        <article class="kc-info-card h-100">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="kc-icon-box">
              <img src="/assets/icons/icon-visibility.svg" alt="" width="24" height="24">
            </div>
            <h4 class="kc-card-title mb-0"><%= t.about.visionTitle %></h4>
          </div>
          <p class="kc-card-text mb-0"><%= t.about.visionBody %></p>
        </article>
      </div>
    </div>

    <!-- Learning Approach -->
    <h3 class="kc-subsection-title text-center mt-5 mb-4"><%= t.about.approachHeading %></h3>
    <div class="row g-4">
      <% t.about.approaches.forEach((item) => { %>
      <div class="col-12 col-sm-6 col-lg-3">
        <article class="kc-approach-card h-100 text-center">
          <div class="kc-icon-box kc-icon-box-lg mx-auto mb-3">
            <img src="/assets/icons/<%= item.icon %>" alt="" width="24" height="24">
          </div>
          <h4 class="kc-approach-title"><%= item.title %></h4>
          <p class="kc-approach-text mb-0"><%= item.body %></p>
        </article>
      </div>
      <% }); %>
    </div>
  </div>
</section>
