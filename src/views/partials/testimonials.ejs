<section class="kc-section kc-testimonials" id="testimonials">
  <div class="container-xxl kc-container">
    <div class="kc-section-header text-center mx-auto">
      <div class="kc-eyebrow"><%= t.testimonials.badge %></div>
      <h2 class="kc-section-title"><%= t.testimonials.heading %></h2>
      <p class="kc-section-subtitle mb-0"><%= t.testimonials.subtitle %></p>
    </div>
  </div>

  <div class="kc-marquee-viewport mt-5" role="region" aria-label="<%= t.a11y.testimonialsLabel %>">
    <div class="kc-marquee-track">
      <!-- Primary set -->
      <% t.testimonials.items.forEach((item) => { %>
      <figure class="kc-testimonial-card mb-0">
        <div>
          <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
            <div class="kc-stars" aria-label="<%= t.a11y.ratingLabel %>">
              <% for (let i = 0; i < 5; i++) { %>
              <img src="/assets/icons/icon-star.svg" alt="" width="14" height="14">
              <% } %>
            </div>
            <span class="kc-course-badge-pill">
              <span><%= item.courseBadge %></span>
              <img src="/assets/icons/<%= item.flag %>" alt="" width="16" height="12" class="kc-inline-flag">
            </span>
          </div>
          <blockquote class="kc-testimonial-quote mb-0">
            <p class="mb-0"><%= item.quote %></p>
          </blockquote>
        </div>

        <figcaption class="kc-testimonial-author">
          <div class="kc-avatar-circle" aria-hidden="true"><%= item.initials %></div>
          <div>
            <div class="kc-author-name"><%= item.name %></div>
            <div class="kc-author-role"><%= item.role %></div>
          </div>
        </figcaption>
      </figure>
      <% }); %>

      <!-- Duplicate set for seamless infinite scroll -->
      <% t.testimonials.items.forEach((item) => { %>
      <figure class="kc-testimonial-card mb-0" aria-hidden="true">
        <div>
          <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
            <div class="kc-stars">
              <% for (let i = 0; i < 5; i++) { %>
              <img src="/assets/icons/icon-star.svg" alt="" width="14" height="14">
              <% } %>
            </div>
            <span class="kc-course-badge-pill">
              <span><%= item.courseBadge %></span>
              <img src="/assets/icons/<%= item.flag %>" alt="" width="16" height="12" class="kc-inline-flag">
            </span>
          </div>
          <blockquote class="kc-testimonial-quote mb-0">
            <p class="mb-0"><%= item.quote %></p>
          </blockquote>
        </div>

        <figcaption class="kc-testimonial-author">
          <div class="kc-avatar-circle"><%= item.initials %></div>
          <div>
            <div class="kc-author-name"><%= item.name %></div>
            <div class="kc-author-role"><%= item.role %></div>
          </div>
        </figcaption>
      </figure>
      <% }); %>
    </div>
  </div>
</section>
